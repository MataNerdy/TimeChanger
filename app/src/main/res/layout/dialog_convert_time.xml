<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/homeLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home time"
            android:textStyle="bold"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/homeTimeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="14:00"
            android:inputType="time"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/homeDayInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/targetLabelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Berlin time"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/targetTimeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="12:00"
            android:inputType="time"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/targetDayInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/converterHintText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter time in H:mm or HH:mm format"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>